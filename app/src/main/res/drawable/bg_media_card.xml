<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_card_focused" />
            <corners android:radius="@dimen/tv_card_radius" />
            <stroke android:width="@dimen/tv_focus_stroke" android:color="@color/border_focused" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_card" />
            <corners android:radius="@dimen/tv_card_radius" />
            <stroke android:width="1dp" android:color="@color/border_light" />
        </shape>
    </item>
</selector>
