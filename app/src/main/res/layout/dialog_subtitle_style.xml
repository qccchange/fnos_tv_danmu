<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#FF1A1A1A">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="字幕样式"
            android:textColor="#FFF"
            android:textSize="@dimen/tv_text_title"
            android:textStyle="bold"
            android:paddingBottom="12dp" />

        <include layout="@layout/item_danmu_slider" android:id="@+id/sub_size" />
        <include layout="@layout/item_danmu_slider" android:id="@+id/sub_pos" />
        <include layout="@layout/item_danmu_slider" android:id="@+id/sub_opacity" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="字幕颜色"
            android:textColor="#EEE"
            android:textSize="@dimen/tv_text_caption"
            android:paddingTop="10dp"
            android:paddingBottom="4dp" />

        <LinearLayout
            android:id="@+id/sub_colors"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="10dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="覆盖字幕内嵌颜色/字号"
                android:textColor="#EEE"
                android:textSize="@dimen/tv_text_caption" />

            <Switch
                android:id="@+id/sub_override"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:focusable="true" />

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="图片字幕（PGS/DVB）仅支持位置与透明度，颜色不可用"
            android:textColor="#888"
            android:textSize="@dimen/tv_text_caption"
            android:paddingTop="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingTop="14dp">

            <Button
                android:id="@+id/sub_apply"
                android:layout_width="0dp"
                android:layout_height="@dimen/tv_control_h"
                android:layout_weight="1"
                android:layout_marginRight="4dp"
                android:background="@drawable/bg_chip"
                android:text="预览"
                android:textColor="#CCC"
                android:focusable="true" />

            <Button
                android:id="@+id/sub_cancel"
                android:layout_width="0dp"
                android:layout_height="@dimen/tv_control_h"
                android:layout_weight="1"
                android:layout_marginLeft="4dp"
                android:layout_marginRight="4dp"
                android:background="@drawable/bg_chip"
                android:text="取消"
                android:textColor="#999"
                android:focusable="true" />

            <Button
                android:id="@+id/sub_ok"
                android:layout_width="0dp"
                android:layout_height="@dimen/tv_control_h"
                android:layout_weight="1"
                android:layout_marginLeft="4dp"
                android:background="@drawable/bg_chip"
                android:text="确定"
                android:textColor="#FFF"
                android:focusable="true" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
